rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn()
        && request.auth.token.role == role
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == role
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function canManageMemberPhotos() {
      return hasRole('SUPER_ADMIN') || hasRole('MANAGER') || hasRole('RECEPTIONIST');
    }

    match /members/{memberId}/profile.jpg {
      allow read: if canManageMemberPhotos()
        || (hasRole('TRAINER') && firestore.get(/databases/(default)/documents/members/$(memberId)).data.trainerUid == request.auth.uid)
        || (hasRole('MEMBER') && firestore.get(/databases/(default)/documents/members/$(memberId)).data.authUid == request.auth.uid);
      allow write: if canManageMemberPhotos()
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canManageMemberPhotos();
    }

    match /expenses/{expenseId}/{fileName} {
      allow read: if hasRole('SUPER_ADMIN') || hasRole('MANAGER');
      allow write: if (hasRole('SUPER_ADMIN') || hasRole('MANAGER'))
        && fileName.matches('receipt\\.(pdf|png|jpg|jpeg|webp)')
        && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if hasRole('SUPER_ADMIN') || hasRole('MANAGER');
    }

    match /gallery/images/{galleryId}/{fileName} {
      allow read: if true;
      allow write: if (hasRole('SUPER_ADMIN') || hasRole('MANAGER'))
        && request.resource != null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasRole('SUPER_ADMIN') || hasRole('MANAGER');
    }

    match /gallery/videos/{galleryId}/{fileName} {
      allow read: if true;
      allow write: if (hasRole('SUPER_ADMIN') || hasRole('MANAGER'))
        && request.resource != null
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if hasRole('SUPER_ADMIN') || hasRole('MANAGER');
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
